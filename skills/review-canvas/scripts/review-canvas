#!/usr/bin/env bash
# The review-canvas command, run from wherever this skill is installed.
#
# The command lives in packages/review-canvas of the repository this skill ships in. On first use, and again when the
# package's dependencies or page sources change, this installs its dependencies and builds its page assets. It needs
# Node 26 and pnpm, and network access the first time. Progress goes to stderr, so stdout stays the command's JSON.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
package="${REVIEW_CANVAS_PACKAGE:-$here/../../../packages/review-canvas}"
if [[ ! -f "$package/package.json" ]]; then
  printf 'review-canvas: no package at %s. Set REVIEW_CANVAS_PACKAGE to packages/review-canvas.\n' "$package" >&2
  exit 1
fi
package="$(cd "$package" && pwd)"

major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if ((major < 26)); then
  printf 'review-canvas: needs Node 26 or newer; found %s.\n' "$(node --version 2>/dev/null || echo none)" >&2
  exit 1
fi

manifest="$package/dist/client/.vite/manifest.json"
stale() {
  [[ ! -d "$package/node_modules" || "$package/pnpm-lock.yaml" -nt "$package/node_modules" ]] && return 0
  [[ ! -f "$manifest" ]] && return 0
  [[ -n "$(find "$package/src/client" "$package/src/server" "$package/../../skills/internal-visual-style/assets" \
    -newer "$manifest" -type f -print -quit 2>/dev/null)" ]]
}

if stale; then
  if ! command -v pnpm >/dev/null; then
    printf 'review-canvas: needs pnpm to install and build %s.\n' "$package" >&2
    exit 1
  fi
  # One install at a time: a second command waits for the first.
  lock="$package/.setup.lock"
  for _ in $(seq 600); do
    mkdir "$lock" 2>/dev/null && break
    sleep 0.5
  done
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  if stale; then
    printf 'review-canvas: installing and building %s\n' "$package" >&2
    pnpm --dir "$package" install --frozen-lockfile >&2
    touch "$package/node_modules"
    pnpm --dir "$package" build >&2
  fi
  rmdir "$lock" 2>/dev/null || true
  trap - EXIT
fi

exec node "$package/src/cli/main.ts" "$@"
