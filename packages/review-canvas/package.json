{
  "name": "@pyre-agent/review-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.node.config.ts",
    "start": "node src/server/main.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc-rs -p tsconfig.json",
    "cli": "node src/cli/main.ts",
    "test:pack": "node scripts/pack-test.ts",
    "test:browser": "node --test 'browser/**/*.test.ts'",
    "test:github": "node scripts/github-live-test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "tsc-rs": "0.2.0",
    "vite": "8.3.4"
  },
  "bin": {
    "review-canvas": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
